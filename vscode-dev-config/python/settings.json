{
  // =============================================================================
  // 🐍 PYTHON 编程语言相关配置
  // =============================================================================
  // -------------------- Python 解释器配置 --------------------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python3", // 默认Python解释器路径
  "python.terminal.activateEnvironment": true, // 终端启动时激活虚拟环境
  "python.terminal.activateEnvInCurrentTerminal": true, // 在当前终端中激活环境
  "python.envFile": "${workspaceFolder}/.env", // Python环境变量文件路径
  // -------------------- Python 语言特定设置 --------------------
  "[python]": {
    "editor.formatOnSave": false, // 保存时不自动格式化(由Ruff处理)
    "editor.codeActionsOnSave": { // 保存时执行的操作
      "source.fixAll": "explicit", // 自动修复所有问题
      "source.organizeImports": "explicit" // 自动整理导入语句
    },
    "editor.rulers": [ // 显示标尺线
      88, // PEP 8推荐行长
      120 // 最大行长限制
    ],
    "editor.tabSize": 4, // Tab宽度为4个空格
    "editor.insertSpaces": true // 使用空格而非Tab字符
  },
  // -------------------- Ruff Linting & Formatting --------------------
  "ruff.enable": true, // 启用Ruff语言服务器
  "ruff.nativeServer": true, // 使用Ruff原生服务器
  "ruff.fixAll": true, // 启用自动修复功能
  "ruff.configurationPreference": "filesystemFirst", // 优先使用文件系统配置
  // -------------------- Basedpyright 类型检查 --------------------
  "basedpyright.analysis.typeCheckingMode": "basic", // 类型检查模式(基础)
  "basedpyright.analysis.autoImportCompletions": true, // 启用自动导入补全
  "basedpyright.analysis.inlayHints.functionReturnTypes": true, // 显示函数返回类型提示
  "basedpyright.analysis.inlayHints.variableTypes": false, // 不显示变量类型提示
  "basedpyright.analysis.diagnosticSeverityOverrides": { // 诊断严重性覆盖设置
    // 降为警告
    "reportUnusedImport": "warning", // 未使用导入->警告
    "reportUnusedVariable": "warning", // 未使用变量->警告
    "reportUnusedFunction": "warning", // 未使用函数->警告
    "reportUnusedClass": "warning", // 未使用类->警告
    "reportPrivateUsage": "warning", // 私有成员使用->警告
    // 禁用第三方库误报
    "reportArgumentType": "none", // 参数类型检查->禁用
    "reportGeneralTypeIssues": "none", // 通用类型问题->禁用
    "reportMissingTypeStubs": "none", // 缺少类型存根->禁用
    "reportUnknownMemberType": "none", // 未知成员类型->禁用
    "reportUnknownArgumentType": "none", // 未知参数类型->禁用
    "reportUnknownVariableType": "none", // 未知变量类型->禁用
    "reportCallInDefaultInitializer": "none", // 默认初始化器调用->禁用
    "reportUnnecessaryIsInstance": "none", // 不必要的isinstance->禁用
    // 降级为信息
    "reportOptionalMemberAccess": "information", // 可选成员访问->信息
    "reportUnnecessaryComparison": "information", // 不必要比较->信息
    "reportAttributeAccessIssue": "information" // 属性访问问题->信息
  },
  // -------------------- 测试配置 --------------------
  "python.testing.pytestEnabled": true, // 启用pytest测试框架
  "python.testing.unittestEnabled": false, // 禁用unittest框架
  "python.testing.pytestArgs": [ // pytest命令行参数
    "tests", // 测试目录
    "-s", // 显示print输出
    "-v", // 详细输出模式
    "--tb=short" // 简短traceback格式
  ],
  // -------------------- 文件关联 --------------------
  "files.associations": { // 文件类型关联
    "*.yaml": "yaml", // .yaml文件关联到YAML语言
    "*.yml": "yaml", // .yml文件关联到YAML语言
    "*.j2": "jinja", // .j2文件关联到Jinja模板
    "*.jinja2": "jinja" // .jinja2文件关联到Jinja模板
  },
  // -------------------- 文件排除 --------------------
  "files.exclude": { // 文件资源管理器排除项
    "**/__pycache__": true, // 排除Python缓存目录
    "**/*.pyc": true, // 排除编译后的Python文件
    "**/*.pyo": true, // 排除优化后的Python文件
    "**/.pytest_cache": true, // 排除pytest缓存
    "**/.ruff_cache": true, // 排除Ruff缓存
    "**/*.egg-info": true, // 排除包信息目录
    "**/.mypy_cache": true // 排除MyPy缓存
  },
  // -------------------- 搜索排除 --------------------
  "search.exclude": { // 搜索功能排除项
    "**/__pycache__": true, // 排除缓存目录
    "**/node_modules": true, // 排除Node.js模块
    "**/.venv": true, // 排除虚拟环境目录
    "**/uv.lock": true, // 排除uv锁文件
    "**/*.lock": true // 排除其他锁文件
  },
  // -------------------- YAML 语言配置 --------------------
  "[yaml]": {
    "editor.tabSize": 2, // YAML使用2空格缩进
    "editor.insertSpaces": true, // 使用空格缩进
    "editor.autoIndent": "advanced" // 高级自动缩进
  },
  // -------------------- JSON 语言配置 --------------------
  "[json]": {
    "editor.tabSize": 2, // JSON使用2空格缩进
    "editor.formatOnSave": true, // 保存时自动格式化
    "editor.defaultFormatter": "vscode.json-language-features" // 使用VS Code内置格式化器
  },
  "[jsonc]": {
    "editor.tabSize": 2, // JSONC使用2空格缩进
    "editor.formatOnSave": true // 保存时自动格式化
  }
}
