{
  // =============================================================================
  // 🐍 VS Code Python 开发配置
  // =============================================================================
  // -------------------- Python 环境与终端 --------------------
  "python.terminal.activateEnvironment": true, // 工作区终端自动激活环境
  "python.terminal.activateEnvInCurrentTerminal": true, // 已打开终端也允许激活当前环境
  "python.terminal.shellIntegration.enabled": true, // 启用 Python 终端 shell integration
  "python.terminal.useEnvFile": true, // 让终端也读取 `.env`
  "python.envFile": "${workspaceFolder}/.env",
  // -------------------- Python 编辑体验 --------------------
  "python.analysis.autoSearchPaths": false, // 禁用自动搜索路径，避免引入隐式路径
  "python.analysis.extraPaths": [],
  "python.analysis.exclude": [
    "**/.*",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache",
    "**/.tox",
    "**/.nox",
    "**/build",
    "**/dist",
    "**/site-packages",
    "**/.git",
    "**/.idea",
    "**/logs",
    "**/.hypothesis",
    "**/htmlcov",
    "**/*.egg-info"
  ],
  "[python]": {
    "editor.formatOnSave": false, // 关闭保存时自动格式化
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "never", // 不在保存时自动修复
      "source.organizeImports.ruff": "always" // 保存时自动整理导入
    },
    "editor.rulers": [
      88,
      120
    ],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.wordBasedSuggestions": "off" // Python 更适合依赖语言服务器补全
  },
  // -------------------- Ruff：Lint + Format --------------------
  "ruff.enable": true,
  "ruff.nativeServer": "auto", // 优先使用 Rust 原生服务器
  "ruff.configurationPreference": "editorOnly", // 以编辑器内配置为准
  "ruff.configuration": {
    "line-length": 88,
    "lint": {
      "preview": true,
      "select": [
        "E",
        "F",
        "I",
        "UP",
        "B",
        "C4",
        "SIM",
        "PLR6301",
        "PLR1711",
        "PLR1733",
        "PLR1714"
      ],
      "ignore": [
        "I001"
      ],
      "flake8-bugbear": {
        "extend-immutable-calls": [
          "fastapi.Query",
          "fastapi.Path",
          "fastapi.Header",
          "fastapi.Depends",
          "fastapi.Body",
          "fastapi.File"
        ]
      }
    }
  },
  // -------------------- Pylance / 分析配置 --------------------
  "python.languageServer": "Pylance",
  "python.analysis.diagnosticMode": "openFilesOnly", // 仅分析打开的文件
  "python.analysis.autoImportCompletions": true, // 关闭自动导入补全
  "python.analysis.completeFunctionParens": true, // 补全函数时自动补全括号
  "python.analysis.inlayHints.functionReturnTypes": true, // 显示函数返回值提示
  "python.analysis.inlayHints.variableTypes": false, // 不显示变量类型提示
  "python.analysis.inlayHints.callArgumentNames": "partial", // 部分显示参数名提示
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnusedImport": "none",
    "reportUnusedVariable": "none",
    "reportMissingTypeStubs": "none"
  }, // 关闭与 Ruff 重复或低价值的 Pylance 诊断
  // -------------------- 测试配置 --------------------
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.autoTestDiscoverOnSavePattern": "tests/**/*.py",
  "python.testing.pytestArgs": [
    "tests",
    "-s",
    "-v",
    "--tb=short"
  ],
  // -------------------- Notebook / Jupyter --------------------
  // Ruff 官方当前已支持 notebook 的 lint / format / organize imports
  "notebook.formatOnSave.enabled": false,
  "notebook.codeActionsOnSave": {
    "notebook.source.fixAll": "explicit",
    "notebook.source.organizeImports": "explicit"
  },
  // -------------------- 文件关联 --------------------
  "files.associations": {
    "*.j2": "jinja",
    "*.jinja2": "jinja",
    "*.pyi": "python",
    "pyproject.toml": "toml"
  }
}
