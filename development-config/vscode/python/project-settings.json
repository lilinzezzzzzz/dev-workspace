{
  // Python 项目覆盖示例，按项目实际结构选择

  // 环境文件
  "python.terminal.useEnvFile": true, // 让终端也读取 `.env`
  "python.envFile": "${workspaceFolder}/.env",

  // 项目导入路径与分析范围
  "python.analysis.autoSearchPaths": false, // 禁用自动搜索路径，避免引入隐式路径
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.analysis.exclude": [
    "**/.*",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.mypy_cache",
    "**/.tox",
    "**/.nox",
    "**/build",
    "**/dist",
    "**/site-packages",
    "**/.git",
    "**/.idea",
    "**/logs",
    "**/.hypothesis",
    "**/htmlcov",
    "**/*.egg-info"
  ],

  // 测试体系与发现范围
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}",
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.autoTestDiscoverOnSavePattern": "tests/**/*.py",
  "python.testing.pytestArgs": [
    "tests",
    "-s",
    "-v",
    "--tb=short"
  ],

  // 项目文件关联
  "files.associations": {
    "*.j2": "jinja",
    "*.jinja2": "jinja",
    "*.pyi": "python",
    "pyproject.toml": "toml"
  }
}
