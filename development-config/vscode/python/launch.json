{
  // =============================================================================
  // 🐍 VS Code Python 调试最佳实践配置（与当前 settings.json 配套）
  // =============================================================================
  // 说明：
  // 1. 不显式指定 `python`，调试器会自动使用工作区当前选中的解释器
  // 2. 默认读取 `${workspaceFolder}/.env`
  // 3. Web 场景默认关闭热重载，避免调试时生成子进程影响断点稳定性
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 FastAPI: Uvicorn (main:app)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "args": [
        "main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Uvicorn running on (http://\\S+)"
      }
    },
    {
      "name": "🐍 Python: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "justMyCode": true
    },
    {
      "name": "🧪 Pytest: Current File",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "args": [
        "${file}",
        "-s",
        "-v",
        "--tb=short"
      ],
      "justMyCode": true
    }
  ]
}
