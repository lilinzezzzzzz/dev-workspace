{
  // 用户级 Go 默认设置，保留原模板工具选择

  // Go 工具与编辑体验
  "go.useLanguageServer": true, // 启用 Go 语言服务器 (gopls)
  "go.toolsManagement.autoUpdate": true, // 自动更新 Go 工具（如 goimports、dlv 等）
  "go.toolsGopath": "", // Go 工具安装路径（默认为 GOPATH/bin，留空使用默认）
  "go.alternateTools": {
    "go": "~/.local/share/mise/shims/go" // 使用 mise 管理项目 Go 版本
  },
  "go.formatTool": "goimports", // 使用 goimports（自动处理导入）
  "go.lintTool": "golangci-lint", // 使用 golangci-lint
  "go.lintOnSave": "package", // 保存时对包进行 lint
  "go.coverOnSave": false, // 保存时不显示覆盖率
  "go.coverOnSingleTest": true, // 单个测试显示覆盖率
  "go.coverOnSingleTestFile": true, // 单个测试文件显示覆盖率
  "go.coverageDecorator": {
    "type": "gutter", // 在装订线显示
    "coveredHighlightColor": "rgba(64,128,64,0.5)",
    "uncoveredHighlightColor": "rgba(128,64,64,0.5)",
    "coveredGutterStyle": "blockgreen",
    "uncoveredGutterStyle": "blockred"
  },

  // Go 语言设置
  "[go]": {
    "editor.formatOnSave": true, // 保存时自动格式化
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit" // 自动整理导入语句
    },
    "editor.rulers": [
      80, // Go 官方推荐行长
      120 // 最大行长限制
    ],
    "editor.tabSize": 4, // Tab 宽度为 4
    "editor.insertSpaces": false, // Go 官方风格：使用 Tab 而非空格
    "editor.defaultFormatter": "golang.go", // 使用 Go 官方格式化器
    "editor.suggest.snippetsPreventQuickSuggestions": false, // 允许 snippet 中显示建议（提高补全效率）
    "editor.quickSuggestions": {
      "other": true, // 普通代码中启用智能提示
      "comments": false, // 注释中禁用智能提示
      "strings": true // 字符串中也启用补全（便于填写 JSON 标签等）
    }
  },
  "[go.mod]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "golang.go"
  },
  "[go.sum]": {
    "editor.formatOnSave": false // go.sum 文件不格式化
  },

  // gopls 补全、提示与分析偏好
  "gopls": {
    // 静态分析
    "staticcheck": true, // 启用静态检查
    "analyses": {
      "unusedparams": true, // 检查未使用的参数
      "shadow": true, // 检查变量遮蔽
      "fieldalignment": false, // 不检查字段对齐（太严格）
      "nilness": true, // 检查 nil 安全性
      "unusedwrite": true, // 检查未使用的写操作
      "useany": true, // 建议使用 any 类型（替代 interface{}）
      "fillreturns": true, // 自动填充返回值（补全函数返回）
      "nonewreturns": true, // 检查不必要的 new 返回
      "undeclaredname": true // 检查未声明的名称
    },
    // 代码补全
    "completeUnimported": true, // 补全未导入的包（自动添加 import）
    "usePlaceholders": true, // 使用占位符（补全时显示参数名）
    "completionBudget": "100ms", // 补全超时时间（控制响应速度）
    // 提示配置
    "ui.inlayhint.hints": {
      "assignVariableTypes": false, // 不显示赋值变量类型
      "compositeLiteralFields": true, // 显示复合字面量字段
      "compositeLiteralTypes": false, // 不显示复合字面量类型
      "constantValues": true, // 显示常量值
      "functionTypeParameters": false, // 不显示函数类型参数
      "parameterNames": true, // 显示参数名
      "rangeVariableTypes": false // 不显示 range 变量类型
    },
    // 代码导航
    "importShortcut": "Both", // 导入快捷方式
    // 语义高亮
    "semanticTokens": true,
    // 诊断延迟
    "diagnosticsDelay": "500ms"
  },

  // Delve 调试器显示偏好
  "go.delveConfig": {
    "dlvLoadConfig": {
      "followPointers": true, // 跟踪指针
      "maxVariableRecurse": 1, // 变量递归深度
      "maxStringLen": 512, // 字符串最大长度
      "maxArrayValues": 64, // 数组最大值数量
      "maxStructFields": -1 // 结构体字段无限制
    },
    "apiVersion": 2,
    "showGlobalVariables": false, // 不显示全局变量
    "debugAdapter": "dlv-dap" // 使用 DAP 适配器
  },

  // 辅助文件编辑偏好
  "[makefile]": {
    "editor.insertSpaces": false, // Makefile 必须使用 Tab
    "editor.tabSize": 4
  },
  "[dockerfile]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
