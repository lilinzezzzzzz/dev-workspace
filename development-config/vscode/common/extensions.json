    "ms-vscode-remote.remote-ssh",
    // Container Tools：容器与镜像管理（Docker 的继任者）
    "ms-azuretools.vscode-containers",
    // Docker DX：Dockerfile / Compose / Bake 编辑增强（可选）
    "docker.docker",
