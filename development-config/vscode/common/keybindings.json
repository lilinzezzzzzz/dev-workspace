[
  // ==================== 重要说明 ====================
  // ⚠️ keybindings.json 只能放在用户级别目录才生效，不支持工作区级别！
  //
  // Qoder 用户目录:
  //   macOS:   ~/Library/Application Support/Qoder/User/keybindings.json
  //   Windows: %APPDATA%\Qoder\User\keybindings.json
  //   Linux:   ~/.config/Qoder/User/keybindings.json
  //
  // VS Code 用户目录:
  //   macOS:   ~/Library/Application Support/Code/User/keybindings.json
  //   Windows: %APPDATA%\Code\User\keybindings.json
  //   Linux:   ~/.config/Code/User/keybindings.json
  //
  // 应用配置:
  // cp keybindings.json <目标用户目录>/keybindings.json
  // ==================================================

  // ==================== 导航快捷键 ====================
  // 后退: Windows/Linux 使用 Ctrl+Alt+Left, macOS 使用 Cmd+Opt+Left
  {
    "key": "ctrl+alt+left",
    "command": "workbench.action.navigateBack",
    "when": "!isMac"
  },
  {
    "key": "cmd+alt+left",
    "command": "workbench.action.navigateBack",
    "when": "isMac"
  },
  // 前进: Windows/Linux 使用 Ctrl+Alt+Right, macOS 使用 Cmd+Opt+Right
  {
    "key": "ctrl+alt+right",
    "command": "workbench.action.navigateForward",
    "when": "!isMac"
  },
  {
    "key": "cmd+alt+right",
    "command": "workbench.action.navigateForward",
    "when": "isMac"
  },
  // ==================== 格式化文档快捷键 ====================
  // 格式化文档：Windows/Linux 使用 Ctrl+Alt+L, macOS 使用 Cmd+Opt+L (PyCharm 风格)
  {
    "key": "ctrl+alt+l",
    "command": "editor.action.formatDocument",
    "when": "!isMac"
  },
  {
    "key": "cmd+alt+l",
    "command": "editor.action.formatDocument",
    "when": "isMac"
  },
  // 移除 VS Code 默认的 Shift+Alt+F 和 Cmd+Shift+F 快捷键（跨平台）
  {
    "key": "shift+alt+f",
    "command": "-editor.action.formatDocument"
  },
  {
    "key": "shift+cmd+f",
    "command": "-editor.action.formatDocument"
  }
]
