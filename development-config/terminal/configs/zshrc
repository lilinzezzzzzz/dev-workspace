# Shell defaults
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"

# Python local development
# 避免本地运行 Python 时生成 __pycache__/pyc 缓存文件。
export PYTHONDONTWRITEBYTECODE=1
# 在解释器崩溃、死锁或收到致命信号时输出 Python traceback，便于排查。
export PYTHONFAULTHANDLER=1
# 防止误用系统 Python 执行 pip install，要求 pip 必须运行在虚拟环境中。
export PIP_REQUIRE_VIRTUALENV=true
# 关闭 pip 版本检查提示，减少本地命令输出噪音。
export PIP_DISABLE_PIP_VERSION_CHECK=1
# 让 uv 复制缓存文件而不是 hardlink，提升跨文件系统、容器挂载目录的兼容性。
export UV_LINK_MODE=copy

# Keep PATH stable and deduplicated across hosts.
typeset -U path PATH
for dir in \
  /opt/homebrew/bin \
  /usr/local/bin \
  "$HOME/go/bin" \
  "$HOME/.cargo/bin" \
  "$HOME/bin" \
  "$HOME/.local/bin" \
  /Applications/Ghostty.app/Contents/MacOS
do
  [[ -d "$dir" ]] && path=("$dir" $path)
done
export PATH

if command -v nvim >/dev/null 2>&1; then
  export EDITOR="${EDITOR:-nvim}"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="${EDITOR:-vim}"
else
  export EDITOR="${EDITOR:-vi}"
fi
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"

# Enable ls colors on macOS
export CLICOLOR=1
export LSCOLORS="Gxfxcxdxbxegedabagacad"

# Enable ls colors on Linux (GNU ls)
if [[ "$OSTYPE" == "linux-gnu"* ]]; then
  alias ls='ls --color=auto'
  alias ll='ls -alF --color=auto'
  alias la='ls -A --color=auto'
  alias l='ls -CF --color=auto'
else
  # macOS BSD ls
  alias ll='ls -alF'
  alias la='ls -A'
  alias l='ls -CF'
fi

export HISTSIZE=10000
export SAVEHIST=20000
setopt APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS
setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt INTERACTIVE_COMMENTS
setopt NO_HUP

ZSH_THEME=""
DISABLE_AUTO_TITLE="true"

plugins=(
  git
  docker
  extract
  sudo
  copypath
  fzf
  zsh-autosuggestions
  zsh-syntax-highlighting
)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
