# Ghostty Terminal Configuration
# 使用内置主题，简化配置。可用主题列表: ghostty +list-themes

theme = "Atom"

# 字体 (fallback: MesloLGS NF -> JetBrains Mono)
font-family = "MesloLGS NF"
font-family = "JetBrains Mono"
font-size = 13

# 窗口
window-theme = "dark"
window-padding-x = 10
window-padding-y = 10

# 光标
cursor-style = "bar"
cursor-style-blink = true
mouse-hide-while-typing = true
