{
  // =============================================================================
  // 🐹 GO 编程语言相关配置
  // =============================================================================
  // -------------------- Go 基础配置 --------------------
  "go.useLanguageServer": true, // 启用 Go 语言服务器 (gopls)
  "go.toolsManagement.autoUpdate": true, // 自动更新 Go 工具
  // -------------------- Go 语言特定设置 --------------------
  "[go]": {
    "editor.formatOnSave": true, // 保存时自动格式化
    "editor.codeActionsOnSave": { // 保存时执行的操作
      "source.organizeImports": "explicit" // 自动整理导入语句
    },
    "editor.rulers": [ // 显示标尺线
      80, // 推荐行长
      120 // 最大行长限制
    ],
    "editor.tabSize": 4, // Tab宽度为4个空格
    "editor.insertSpaces": false, // 使用Tab而非空格
    "editor.defaultFormatter": "golang.go" // 使用Go官方格式化器
  },
  "[go.mod]": {
    "editor.formatOnSave": true, // go.mod文件保存时格式化
    "editor.defaultFormatter": "golang.go" // 使用Go官方格式化器
  },
  "[go.sum]": {
    "editor.formatOnSave": false // go.sum文件不格式化
  },
  // -------------------- gopls 语言服务器配置 --------------------
  "gopls": {
    // 静态分析
    "staticcheck": true, // 启用静态检查
    // 代码补全
    "completeUnimported": true, // 补全未导入的包
    "usePlaceholders": true, // 使用占位符
    // 代码分析
    "analyses": {
      "unusedparams": true, // 检查未使用的参数
      "shadow": true, // 检查变量遮蔽
      "fieldalignment": false, // 不检查字段对齐
      "nilness": true, // 检查nil安全性
      "unusedwrite": true, // 检查未使用的写操作
      "useany": true // 建议使用any类型
    },
    // 提示配置
    "hints": {
      "assignVariableTypes": false, // 不显示赋值变量类型
      "compositeLiteralFields": true, // 显示复合字面量字段
      "compositeLiteralTypes": false, // 不显示复合字面量类型
      "constantValues": true, // 显示常量值
      "functionTypeParameters": false, // 不显示函数类型参数
      "parameterNames": true, // 显示参数名
      "rangeVariableTypes": false // 不显示range变量类型
    },
    // 代码导航
    "importShortcut": "Both", // 导入快捷方式
    // 语义高亮
    "semanticTokens": true, // 启用语义高亮
    // 诊断延迟
    "diagnosticsDelay": "500ms" // 诊断延迟500毫秒
  },
  // -------------------- 代码格式化 --------------------
  "go.formatTool": "goimports", // 使用goimports格式化工具
  // Lint 工具配置
  "go.lintTool": "golangci-lint", // 使用golangci-lint
  "go.lintFlags": [ // Lint参数
    "--fast" // 快速模式
  ],
  "go.lintOnSave": "package", // 保存时对包进行lint
  // -------------------- 测试配置 --------------------
  "go.testFlags": [ // 测试参数
    "-v", // 详细输出
    "-race" // 启用竞态检测
  ],
  "go.testTimeout": "30s", // 测试超时时间
  "go.coverOnSave": false, // 保存时不显示覆盖率
  "go.coverOnSingleTest": true, // 单个测试显示覆盖率
  "go.coverOnSingleTestFile": true, // 单个测试文件显示覆盖率
  "go.coverageDecorator": { // 覆盖率装饰器配置
    "type": "gutter", // 在装订线显示
    "coveredHighlightColor": "rgba(64,128,64,0.5)", // 覆盖行高亮颜色
    "uncoveredHighlightColor": "rgba(128,64,64,0.5)", // 未覆盖行高亮颜色
    "coveredGutterStyle": "blockgreen", // 覆盖行装订线样式
    "uncoveredGutterStyle": "blockred" // 未覆盖行装订线样式
  },
  // -------------------- 构建配置 --------------------
  "go.buildOnSave": "off", // 保存时不自动构建
  "go.buildFlags": [], // 构建参数
  "go.buildTags": "", // 构建标签
  // -------------------- 调试配置 --------------------
  "go.delveConfig": {
    "dlvLoadConfig": { // Delve调试器配置
      "followPointers": true, // 跟踪指针
      "maxVariableRecurse": 1, // 变量递归深度
      "maxStringLen": 512, // 字符串最大长度
      "maxArrayValues": 64, // 数组最大值数量
      "maxStructFields": -1 // 结构体字段无限制
    },
    "apiVersion": 2, // API版本
    "showGlobalVariables": false, // 不显示全局变量
    "debugAdapter": "dlv-dap" // 使用DAP适配器
  },
  // -------------------- 文件关联 --------------------
  "files.associations": { // 文件类型关联
    "*.go": "go", // .go文件关联到Go语言
    "go.mod": "go.mod", // go.mod文件
    "go.sum": "go.sum", // go.sum文件
    "*.tmpl": "html", // .tmpl模板文件
    "*.gohtml": "html", // .gohtml模板文件
    "*.yaml": "yaml", // .yaml文件关联到YAML语言
    "*.yml": "yaml" // .yml文件关联到YAML语言
  },
  // -------------------- 文件排除 --------------------
  "files.exclude": { // 文件资源管理器排除项
    "**/vendor": true, // 排除vendor目录
    "**/.git": true, // 排除.git目录
    "**/bin": true, // 排除bin目录
    "**/dist": true // 排除dist目录
  },
  // -------------------- 搜索排除 --------------------
  "search.exclude": { // 搜索功能排除项
    "**/vendor": true, // 排除vendor目录
    "**/node_modules": true, // 排除Node.js模块
    "**/*.lock": true, // 排除锁文件
    "**/go.sum": true // 排除go.sum文件
  },
  // -------------------- Makefile 配置 --------------------
  "[makefile]": {
    "editor.insertSpaces": false, // Makefile使用Tab
    "editor.tabSize": 4 // Tab宽度为4
  },
  // -------------------- Dockerfile 配置 --------------------
  "[dockerfile]": {
    "editor.tabSize": 4, // Dockerfile使用4空格缩进
    "editor.insertSpaces": true // 使用空格缩进
  },
  // -------------------- 终端配置 --------------------
  "terminal.integrated.env.windows": { // Windows终端环境变量
    "GOFLAGS": "-mod=mod" // Go模块模式
  }
}
